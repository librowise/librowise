# Librowise instance 'central' - Managed by `librowise instance`.
# Contains secrets: keep it private (root:librowise 0640 on servers). Edit, then `librowise instance restart central`.
# Every LIBROWISE_* setting is documented in docs/DEPLOYMENT.md.

# --- Processes (read by the systemd units and the instance tool)
LIBROWISE_INSTANCE=central
LIBROWISE_BIND=127.0.0.1
LIBROWISE_PORT=8100
LIBROWISE_WEB_WORKERS=2
LIBROWISE_WORKER_CONCURRENCY=2
LIBROWISE_SIP2_BIND=0.0.0.0
LIBROWISE_SIP2_PORT=6001

# --- Application settings
LIBROWISE_ENVIRONMENT=production
LIBROWISE_SECRET_KEY=SECRET
LIBROWISE_DATABASE_URL=postgresql+psycopg://librowise_central:PW@localhost:5432/librowise_central
LIBROWISE_PUBLIC_URL=https://catalogue.example.org
LIBROWISE_ALLOWED_HOSTS='["catalogue.example.org","localhost","127.0.0.1"]'
LIBROWISE_COOKIE_SECURE=true
LIBROWISE_TIMEZONE=Europe/London
LIBROWISE_LOG_FORMAT=text
LIBROWISE_RATE_LIMIT_BACKEND=database
LIBROWISE_METRICS_TOKEN=TOKEN
LIBROWISE_SCHEDULES='{"nightly":"0 2 * * *","deliver_notices":"*/5 * * * *","maintenance":"30 3 * * *","backup":"15 1 * * *"}'
LIBROWISE_BACKUP_DIR=/var/backups/librowise/central
LIBROWISE_BACKUP_KEEP=14
LIBROWISE_CACHE_DIR=/var/lib/librowise/central/cache
LIBROWISE_DB_STATEMENT_TIMEOUT_MS=30000

# --- E-mail (uncomment to send notices and password-reset links)
# LIBROWISE_EMAIL_BACKEND=smtp
# LIBROWISE_SMTP_HOST=smtp.example.org
# LIBROWISE_SMTP_PORT=587
# LIBROWISE_SMTP_USERNAME=
# LIBROWISE_SMTP_PASSWORD=
# LIBROWISE_SMTP_FROM='Library <library@example.org>'

# --- AI (optional; local models are used without a key)
# ANTHROPIC_API_KEY=
