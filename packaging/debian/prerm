#!/bin/sh
# prerm for librowise: stop every instance before the application is removed.
# On upgrade the processes keep running; postinst migrates and restarts them.
set -e

case "$1" in
    remove | deconfigure)
        if command -v librowise >/dev/null 2>&1 && [ -s /etc/librowise/instances.json ]; then
            librowise instance stop --all >/dev/null 2>&1 || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl stop 'librowise-web@*.service' 'librowise-worker@*.service' \
                'librowise-sip2@*.service' 'librowise@*.target' >/dev/null 2>&1 || true
        fi
        ;;
    upgrade | failed-upgrade) ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
