# Librowise instance 'central' - Managed by `librowise instance`.
# Contains secrets: keep it private (root:librowise 0640 on servers). Edit, then `librowise instance restart central`.
# Every SHELFWISE_* setting is documented in docs/DEPLOYMENT.md.

# --- Processes (read by the systemd units and the instance tool)
LIBROWISE_INSTANCE=central
LIBROWISE_BIND=127.0.0.1
LIBROWISE_PORT=8100
LIBROWISE_WEB_WORKERS=2
LIBROWISE_WORKER_CONCURRENCY=2
LIBROWISE_SIP2_BIND=0.0.0.0
LIBROWISE_SIP2_PORT=6001

# --- Application settings
SHELFWISE_ENVIRONMENT=production
SHELFWISE_SECRET_KEY=SECRET
SHELFWISE_DATABASE_URL=postgresql+psycopg://librowise_central:PW@localhost:5432/librowise_central
SHELFWISE_PUBLIC_URL=https://catalogue.example.org
SHELFWISE_ALLOWED_HOSTS='["catalogue.example.org","localhost","127.0.0.1"]'
SHELFWISE_COOKIE_SECURE=true
SHELFWISE_TIMEZONE=Europe/London
SHELFWISE_LOG_FORMAT=text
SHELFWISE_RATE_LIMIT_BACKEND=database
SHELFWISE_METRICS_TOKEN=TOKEN
SHELFWISE_SCHEDULES='{"nightly":"0 2 * * *","deliver_notices":"*/5 * * * *","maintenance":"30 3 * * *","backup":"15 1 * * *"}'
SHELFWISE_BACKUP_DIR=/var/backups/librowise/central
SHELFWISE_BACKUP_KEEP=14
SHELFWISE_CACHE_DIR=/var/lib/librowise/central/cache
SHELFWISE_DB_STATEMENT_TIMEOUT_MS=30000

# --- E-mail (uncomment to send notices and password-reset links)
# SHELFWISE_EMAIL_BACKEND=smtp
# SHELFWISE_SMTP_HOST=smtp.example.org
# SHELFWISE_SMTP_PORT=587
# SHELFWISE_SMTP_USERNAME=
# SHELFWISE_SMTP_PASSWORD=
# SHELFWISE_SMTP_FROM='Library <library@example.org>'

# --- AI (optional; local models are used without a key)
# ANTHROPIC_API_KEY=
