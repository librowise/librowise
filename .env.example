# Copy to .env and adjust. All settings use the SHELFWISE_ prefix.
SHELFWISE_ENVIRONMENT=production
SHELFWISE_SECRET_KEY=change-me-to-a-long-random-string
SHELFWISE_DATABASE_URL=postgresql+psycopg://shelfwise:shelfwise@db:5432/shelfwise
SHELFWISE_COOKIE_SECURE=true
SHELFWISE_ALLOWED_HOSTS=["library.example.org"]
SHELFWISE_AI_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...
