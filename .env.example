# Copy to .env and adjust. All settings use the LIBROWISE_ prefix.
LIBROWISE_ENVIRONMENT=production
LIBROWISE_SECRET_KEY=change-me-to-a-long-random-string
LIBROWISE_DATABASE_URL=postgresql+psycopg://librowise:librowise@db:5432/librowise
LIBROWISE_COOKIE_SECURE=true
LIBROWISE_ALLOWED_HOSTS=["library.example.org"]
LIBROWISE_AI_ENABLED=true
# ANTHROPIC_API_KEY=sk-ant-...
